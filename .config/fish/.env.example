# chatcpp environment variables - EXAMPLE FILE
# Copy this file to .env and update with your actual API keys

set -x OPENAI_API_KEY "sk-proj-your_openai_api_key_here"
set -x AI_PROVIDER "gemini"  # deepseek | gemini | openai
set -x DEEPSEEK_API_KEY "sk-your_deepseek_api_key_here"
set -x DEEPSEEK_MODEL "deepseek-chat"
set -x AI_API_KEY "your_gemini_api_key_here"
